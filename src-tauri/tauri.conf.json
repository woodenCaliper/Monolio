{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Monolio",
  "version": "1.0.0",
  "identifier": "com.doceditor.desktop",
  "build": {
    "frontendDist": "./frontend",
    "beforeBuildCommand": "npm run tauri:stage",
    "beforeDevCommand": "npm run tauri:stage"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Monolio",
        "width": 1280,
        "height": 860,
        "minWidth": 640,
        "minHeight": 480,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; font-src 'self' data:; connect-src 'self' blob: ipc: http://ipc.localhost; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
